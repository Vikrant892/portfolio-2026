---
import { Image } from 'astro:assets';
import SectionUnderline from '../SectionUnderline.astro';
import { featuredProjects, otherProjects } from '../../data/projects';
---

<section
  id="work"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] py-20 sm:py-28"
  aria-labelledby="work-heading"
>
  <div class="container-site">
    <div class="mb-14 max-w-2xl" data-reveal>
      <p class="t-eyebrow mb-4">Selected work</p>
      <h2 id="work-heading" class="t-heading text-4xl text-[var(--color-ink)] sm:text-5xl">
        Three systems, end to end<span class="text-[var(--color-accent)]">.</span>
      </h2>
      <SectionUnderline />
      <p class="mt-5 text-base leading-relaxed text-[var(--color-ink-muted)]">
        Each one is deployed and public. Open a case study for the full
        write-up, or jump straight to the running demo. Source for everything
        is on GitHub.
      </p>
    </div>

    <div class="space-y-6">
      {
        featuredProjects.map((p, i) => {
          const n = String(i + 1).padStart(2, '0');
          return (
            <article
              data-reveal
              class="group grid grid-cols-1 overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] transition-shadow duration-300 hover:shadow-[var(--shadow-card)] lg:grid-cols-12"
              aria-labelledby={`work-${n}`}
            >
              <a
                href={`/work/${p.slug}`}
                class:list={[
                  'relative block overflow-hidden border-[var(--color-border-subtle)] bg-[var(--color-bg-subtle)] lg:col-span-5',
                  i % 2 === 1 ? 'lg:order-2 lg:border-l' : 'lg:border-r',
                ]}
                aria-label={`Read the ${p.title} case study`}
              >
                <Image
                  src={p.img}
                  alt={`Screenshot of ${p.title}`}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 1024px) 100vw, 460px"
                  class="h-full max-h-72 w-full object-cover object-top transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.025] lg:max-h-none"
                  loading="lazy"
                />
              </a>

              <div class:list={['p-7 sm:p-9 lg:col-span-7', i % 2 === 1 ? 'lg:order-1' : '']}>
                <div class="mono flex items-baseline justify-between gap-4 text-xs">
                  <span class="text-[var(--color-accent)]">{n}</span>
                  <span class="text-[var(--color-ink-dim)]">{p.category}</span>
                </div>
                <h3 id={`work-${n}`} class="t-title mt-3 text-2xl text-[var(--color-ink)] sm:text-3xl">
                  <a href={`/work/${p.slug}`} class="transition-colors hover:text-[var(--color-accent)]">
                    {p.title}
                  </a>
                </h3>

                <dl class="mt-5 space-y-3.5 text-sm leading-relaxed">
                  <div>
                    <dt class="t-eyebrow mb-1">Challenge</dt>
                    <dd class="text-[var(--color-ink-muted)]">{p.challenge}</dd>
                  </div>
                  <div>
                    <dt class="t-eyebrow mb-1">Outcome</dt>
                    <dd class="text-[var(--color-ink)]">{p.outcome}</dd>
                  </div>
                </dl>

                <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technology">
                  {p.stack.map((s) => (
                    <li class="chip !py-0.5 !text-[11px]">{s}</li>
                  ))}
                </ul>

                <div class="mt-6 flex flex-wrap items-center gap-2.5">
                  <a href={`/work/${p.slug}`} class="btn btn-primary !min-h-0 !px-4 !py-2 !text-xs">
                    Read case study <span aria-hidden="true">→</span>
                  </a>
                  <a
                    href={p.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-secondary !min-h-0 !px-4 !py-2 !text-xs"
                  >
                    Live demo <span aria-hidden="true">↗</span>
                  </a>
                  <a
                    href={p.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mono text-xs text-[var(--color-ink-dim)] underline-offset-4 hover:text-[var(--color-ink)] hover:underline"
                  >
                    Source ↗
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    {/* Compact tier */}
    <div class="mt-16" data-reveal-group>
      <p class="t-eyebrow mb-6" data-reveal-child>Also shipped</p>
      <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          otherProjects.map((p) => (
            <li data-reveal-child>
              <article class="group flex h-full flex-col overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-card)]">
                <a
                  href={`/work/${p.slug}`}
                  class="block aspect-[16/9] overflow-hidden border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-subtle)]"
                  aria-label={`Read the ${p.title} case study`}
                >
                  <Image
                    src={p.img}
                    alt={`Screenshot of ${p.title}`}
                    widths={[400, 640]}
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                    class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </a>
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="t-title text-lg text-[var(--color-ink)]">
                    <a href={`/work/${p.slug}`} class="transition-colors hover:text-[var(--color-accent)]">
                      {p.title}
                    </a>
                  </h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                    {p.summary}
                  </p>
                  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
                    <a
                      href={`/work/${p.slug}`}
                      class="btn btn-primary !min-h-0 !px-3.5 !py-1.5 !text-xs"
                    >
                      Case study <span aria-hidden="true">→</span>
                    </a>
                    <a
                      href={p.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mono text-xs text-[var(--color-ink-dim)] underline-offset-4 hover:text-[var(--color-ink)] hover:underline"
                    >
                      Live ↗
                    </a>
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
