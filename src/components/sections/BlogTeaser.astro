---
// Pull the 3 most recent blog posts from vikrant69g.com/blog/rss.xml at build time.
// Failing the fetch (e.g. local dev without internet) renders a graceful empty state.
interface BlogPost {
  title: string;
  link: string;
  pubDate: string;
  description: string;
}

let posts: BlogPost[] = [];
try {
  const res = await fetch('https://vikrant69g.com/blog/rss.xml', {
    headers: { 'User-Agent': 'portfolio-2026-build' },
  });
  if (res.ok) {
    const xml = await res.text();
    const itemMatches = xml.match(/<item>[\s\S]*?<\/item>/g) ?? [];
    posts = itemMatches.slice(0, 3).map((item) => {
      const pick = (tag: string) => {
        const m = item.match(new RegExp(`<${tag}>([\\s\\S]*?)<\\/${tag}>`));
        return m
          ? m[1]
              .replace(/<!\[CDATA\[|\]\]>/g, '')
              .replace(/\s*[--]\s*/g, ', ')
              .trim()
          : '';
      };
      return {
        title: pick('title'),
        link: pick('link'),
        pubDate: pick('pubDate'),
        description: pick('description'),
      };
    });
  }
} catch {
  posts = [];
}

const formatDate = (s: string) => {
  if (!s) return '';
  const d = new Date(s);
  return Number.isNaN(d.getTime())
    ? s
    : d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
};
---

<section
  id="blog"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] py-24 sm:py-32"
  aria-labelledby="blog-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-4">FROM THE BLOG</p>
        <h2
          id="blog-heading"
          class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
        >
          Field notes<span class="text-[var(--color-amber)]">.</span>
        </h2>
      </div>
      <a
        href="https://vikrant69g.com/blog"
        class="mono text-sm text-[var(--color-ink)] underline-offset-4 hover:text-[var(--color-amber)] hover:underline lg:col-span-5 lg:text-right"
      >
        Read all posts →
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="mono text-sm text-[var(--color-ink-muted)]">
        Posts loading. Check back when the blog feed is reachable.
      </p>
    ) : (
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {/* Featured most-recent post takes a full-height card on the left */}
        <a
          href={posts[0].link}
          class="group relative flex h-full flex-col justify-between overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-ink)] p-10 text-[var(--color-ink-on-dark)] transition-all duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-card)] lg:col-span-2 lg:row-span-2"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-0 bg-[radial-gradient(ellipse_at_85%_15%,_var(--color-amber-glow)_0%,_transparent_60%)] opacity-90"
          ></div>
          <div class="relative z-10">
            <p class="mono text-xs uppercase tracking-widest" style="color: var(--color-amber)">
              {formatDate(posts[0].pubDate)} / LATEST
            </p>
            <h3 class="display-script mt-6 text-4xl leading-tight text-[var(--color-ink-on-dark)] sm:text-6xl">
              {posts[0].title}
            </h3>
            <p class="mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-ink-on-dark-muted)]">
              {posts[0].description}
            </p>
          </div>
          <p class="mono relative z-10 mt-10 inline-flex items-center gap-2 text-sm">
            <span class="text-[var(--color-amber)]">Read the post</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </p>
        </a>

        {/* Second post (if it exists), supporting card otherwise */}
        {posts[1] ? (
          <a
            href={posts[1].link}
            class="group relative flex h-full flex-col justify-between rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-8 transition-all duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-card)]"
          >
            <div>
              <p class="mono text-xs text-[var(--color-amber)]">{formatDate(posts[1].pubDate)}</p>
              <h3 class="display-script mt-4 text-2xl text-[var(--color-ink)] group-hover:text-[var(--color-amber)]">
                {posts[1].title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                {posts[1].description}
              </p>
            </div>
            <p class="mono mt-6 text-xs text-[var(--color-ink-dim)]">Read post →</p>
          </a>
        ) : (
          <a
            href="https://vikrant69g.com/blog"
            class="group relative flex h-full flex-col justify-between rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-8 transition-all duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-card)]"
          >
            <div>
              <p class="mono text-xs text-[var(--color-amber)]">MORE POSTS</p>
              <h3 class="display-script mt-4 text-2xl text-[var(--color-ink)] group-hover:text-[var(--color-amber)]">
                Read everything
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                A new post lands every day. The full collection sits on the
                blog, sorted by date and topic.
              </p>
            </div>
            <p class="mono mt-6 text-xs text-[var(--color-ink-dim)]">Go to the blog →</p>
          </a>
        )}

        {/* Third post (if it exists), about card otherwise */}
        {posts[2] ? (
          <a
            href={posts[2].link}
            class="group relative flex h-full flex-col justify-between rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-8 transition-all duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-card)]"
          >
            <div>
              <p class="mono text-xs text-[var(--color-amber)]">{formatDate(posts[2].pubDate)}</p>
              <h3 class="display-script mt-4 text-2xl text-[var(--color-ink)] group-hover:text-[var(--color-amber)]">
                {posts[2].title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                {posts[2].description}
              </p>
            </div>
            <p class="mono mt-6 text-xs text-[var(--color-ink-dim)]">Read post →</p>
          </a>
        ) : (
          <div class="relative flex h-full flex-col justify-between rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-8">
            <div>
              <p class="mono text-xs text-[var(--color-amber)]">WHAT I WRITE ABOUT</p>
              <h3 class="display-script mt-4 text-2xl text-[var(--color-ink)]">
                Real stories, real numbers
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                Mostly stories of what I have actually built: machine learning
                systems, data pipelines, security tools. The honest version,
                not the LinkedIn highlight reel.
              </p>
            </div>
            <p class="mono mt-6 flex items-center gap-2 text-xs text-[var(--color-ink-dim)]">
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-amber)] opacity-60"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[var(--color-amber)]"></span>
              </span>
              NEW POST EVERY DAY
            </p>
          </div>
        )}
      </div>
    )}
  </div>
</section>
