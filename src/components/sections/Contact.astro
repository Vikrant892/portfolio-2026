---
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';

const links = [
  { label: 'LinkedIn', value: 'linkedin.com/in/vik892', href: 'https://www.linkedin.com/in/vik892/' },
  { label: 'GitHub', value: 'github.com/Vikrant892', href: 'https://github.com/Vikrant892' },
  { label: 'X', value: 'x.com/Vik69G', href: 'https://x.com/Vik69G' },
  { label: 'Blog', value: 'vikrant69g.com/blog', href: 'https://vikrant69g.com/blog' },
];
---

<footer
  id="contact"
  class="bg-[var(--color-bg-dark)] py-20 text-[var(--color-ink-on-dark)] sm:py-28"
  aria-labelledby="contact-heading"
>
  <div class="container-site">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <div class="flex items-center gap-4">
          <Image
            src={portrait}
            alt="Vikrant Sharma"
            widths={[96, 192]}
            sizes="56px"
            class="h-14 w-14 rounded-full border border-[var(--color-border-strong)] object-cover"
            loading="lazy"
          />
          <p class="t-eyebrow" style="color: var(--color-accent-on-dark)">Contact</p>
        </div>
        <h2 id="contact-heading" class="t-heading mt-6 text-4xl sm:text-6xl">
          Hiring for ML, data<br />or <span class="t-gradient">security</span>?
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-[var(--color-ink-on-dark-muted)]">
          I am in Adelaide and available for internships of 3 to 6 months,
          part-time engineering work right now, and full-time over the November
          to February break. Graduate roles from August 2027. Email gets a
          reply within 24 hours.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="mailto:vikrantsharma892@gmail.com" class="btn btn-on-dark-primary">
            vikrantsharma892@gmail.com
          </a>
          <button
            id="copy-email"
            type="button"
            class="btn btn-on-dark-secondary"
            data-email="vikrantsharma892@gmail.com"
          >
            <span data-copy-label>Copy email</span>
          </button>
        </div>
        <p
          id="copy-status"
          role="status"
          aria-live="polite"
          class="mono mt-3 h-5 text-xs text-[var(--color-accent-on-dark)]"
        >
        </p>
      </div>

      <ul class="mono grid grid-cols-1 gap-1 self-end lg:col-span-5" data-reveal-group>
        {
          links.map((l) => (
            <li data-reveal-child class="border-t border-[var(--color-border)] first:border-t-0">
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between py-4 text-sm transition-colors hover:text-[var(--color-accent-on-dark)]"
              >
                <span class="t-eyebrow" style="color: var(--color-ink-on-dark-muted)">
                  {l.label}
                </span>
                <span class="text-[var(--color-ink-on-dark)] transition-transform duration-200 group-hover:translate-x-1 group-hover:text-[var(--color-accent-on-dark)]">
                  {l.value} →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mono mt-20 border-t border-[var(--color-border)] pt-8 text-xs text-[var(--color-ink-on-dark-muted)]"
    >
      <p>© 2026 Vikrant Sharma · Adelaide, Australia</p>
    </div>
  </div>
</footer>

<script>
  const btn = document.getElementById('copy-email');
  const status = document.getElementById('copy-status');
  const label = btn?.querySelector('[data-copy-label]');

  btn?.addEventListener('click', async () => {
    const email = btn.getAttribute('data-email') ?? '';
    try {
      await navigator.clipboard.writeText(email);
      if (label) label.textContent = 'Copied';
      if (status) status.textContent = 'Email address copied to clipboard.';
    } catch {
      if (status) status.textContent = email;
    }
    setTimeout(() => {
      if (label) label.textContent = 'Copy email';
      if (status) status.textContent = '';
    }, 2500);
  });
</script>
