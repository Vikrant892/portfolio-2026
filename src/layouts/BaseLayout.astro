---
import { getImage } from 'astro:assets';
import '../styles/globals.css';
import Header from '../components/Header.astro';
import Motion from '../components/Motion.astro';
import ImageGuard from '../components/ImageGuard.astro';
import portrait from '../assets/portrait.jpg';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Hide the sticky site header (used by the print-friendly resume page). */
  bare?: boolean;
}

const {
  title,
  description = 'Vikrant Sharma. Machine learning engineer specialising in cybersecurity. AWS Certified Data Engineer, OCI Data Science Professional, NASA Space Apps Global Finalist. Adelaide, Australia.',
  noindex = false,
  bare = false,
} = Astro.props;

const fullTitle =
  title.toLowerCase() === 'home'
    ? 'Vikrant Sharma | Machine Learning for Threat Detection'
    : `${title} | Vikrant Sharma`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const ogImage = await getImage({ src: portrait, width: 1200, format: 'jpeg' });
const ogImageURL = new URL(ogImage.src, Astro.site).toString();

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Vikrant Sharma',
  alternateName: ['Vikrant Sharma Portfolio', 'vikrant69g'],
  url: 'https://vikrant69g.com',
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vikrant Sharma',
  givenName: 'Vikrant',
  familyName: 'Sharma',
  url: 'https://vikrant69g.com',
  email: 'mailto:vikrantsharma892@gmail.com',
  jobTitle: 'Machine Learning Engineer (Cybersecurity)',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Adelaide',
    addressRegion: 'South Australia',
    addressCountry: 'AU',
  },
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'University of the Sunshine Coast (Adelaide Campus)',
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'Charotar University of Science and Technology',
    },
  ],
  knowsAbout: [
    'Machine Learning',
    'Cybersecurity',
    'Intrusion Detection',
    'Data Engineering',
    'Threat Intelligence',
  ],
  sameAs: [
    'https://github.com/Vikrant892',
    'https://www.linkedin.com/in/vik892/',
    'https://x.com/Vik69G',
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vikrant Sharma" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vikrant Sharma" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#faf9f5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    {/* Gate for reveal styles and saved theme: must run before first
        paint so content never flashes hidden or in the wrong theme. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', '#0b0b0f');
        }
      } catch {
        /* private browsing: default to light */
      }
    </script>
  </head>
  <body id="top" class="min-h-svh bg-[var(--color-bg)] text-[var(--color-ink)]">
    <a href="#main" class="skip-link">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    <Motion />
    <ImageGuard />
  </body>
</html>
