---
import { HeroScroll } from '../ui/hero-scroll';

const proof = [
  { label: 'AWS Certified Data Engineer', href: '#achievements' },
  { label: 'OCI Data Science Professional', href: '#achievements' },
  { label: 'NASA Space Apps Global Finalist', href: '#achievements' },
  { label: '7 systems live in production', href: '#work' },
];
---

<section
  class="relative isolate overflow-hidden border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)]"
  aria-label="Introduction"
>
  {/* Blueprint grid + signal glow backdrop */}
  <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 -z-10"></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[-20%] -z-10 h-[60rem] w-[80rem] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(ellipse at center, rgba(37,99,235,0.07) 0%, rgba(79,70,229,0.04) 45%, transparent 70%);"
  >
  </div>

  <div class="container-site">
    <HeroScroll client:load />
  </div>

  {/* Credential strip */}
  <div class="border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-elevated)]/60">
    <ul
      class="container-site flex flex-wrap items-center justify-center gap-x-2.5 gap-y-2 py-5"
      aria-label="Credentials"
      data-reveal
    >
      {
        proof.map((p) => (
          <li>
            <a
              href={p.href}
              class="chip transition-all duration-200 hover:border-[var(--color-accent)] hover:text-[var(--color-ink)]"
            >
              <span
                aria-hidden="true"
                class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"
              />
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
