# Cloudflare Pages header rules. Applied to every response.
# CSP note: Astro inlines its island-hydration bootstrap scripts, so
# script-src needs 'unsafe-inline'. External script origins stay locked to
# self + Cloudflare Web Analytics.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Hashed build assets never change; cache them forever. Images are
# allowed in image search so the portrait and project shots can surface
# for a name query.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Resume and CV PDFs: short cache so an updated resume propagates within a day.
/resume/*
  Cache-Control: public, max-age=86400
/cv/*
  Cache-Control: public, max-age=86400

# Small root assets that rarely change.
/favicon.svg
  Cache-Control: public, max-age=604800
/og.jpg
  Cache-Control: public, max-age=604800
