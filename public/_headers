# Cloudflare Pages header rules. Applied to every response.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed build assets never change; cache them forever. Images are
# allowed in image search so the portrait and project shots can surface
# for a name query.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Resume PDF: short cache so an updated resume propagates within a day.
/resume/*
  Cache-Control: public, max-age=86400
