---
import { HeroScroll } from '../ui/hero-scroll';

const skills = [
  'Python',
  'TypeScript',
  'Machine learning',
  'Data pipelines',
  'Cloudflare',
  'Security',
];

const proof = [
  '7 public deployments',
  'AWS Data Engineer Associate',
  'OCI Data Science Professional',
  'NASA Space Apps Global Finalist',
];
---

<section
  class="relative isolate overflow-hidden border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)]"
  aria-label="Introduction"
>
  {/* Blueprint grid + signal glow backdrop */}
  <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 -z-10"></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[-20%] -z-10 h-[60rem] w-[80rem] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(ellipse at center, rgba(245,158,11,0.09) 0%, rgba(6,182,212,0.05) 45%, transparent 70%);"
  >
  </div>

  {/* Recruiter summary: static, painted immediately, no reveal gating.
      This is the first-20-seconds content, so it must be instantly
      readable and answer who, what role, where, when, and proof. */}
  <div class="container-site pt-12 pb-12 text-center sm:pt-16">
    <p class="t-eyebrow flex items-center justify-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
      </span>
      Available for internships
    </p>

    <h1 class="t-display mt-5 text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.02] text-[var(--color-ink)]">
      Vikrant Sharma
    </h1>
    <p class="mt-4 text-lg font-medium text-[var(--color-ink)] sm:text-xl">
      ML and Data Engineering Intern
      <span class="text-[var(--color-ink-dim)]">·</span> Adelaide, Australia
    </p>
    <p class="mt-2 text-base text-[var(--color-ink-muted)]">
      Available part-time now, full-time from November 2026.
    </p>

    <ul class="mx-auto mt-6 flex max-w-2xl flex-wrap justify-center gap-2" aria-label="Core skills">
      {skills.map((s) => <li class="chip">{s}</li>)}
    </ul>

    <p class="mx-auto mt-5 max-w-3xl text-sm text-[var(--color-ink-dim)]">
      {
        proof.map((p, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="px-2 text-[var(--color-ink-faint)]">·</span>}
            <span class="text-[var(--color-ink-muted)]">{p}</span>
          </>
        ))
      }
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/resume" class="btn btn-primary">View resume</a>
      <a href="#work" class="btn btn-secondary">See top projects</a>
      <a href="mailto:vikrantsharma892@gmail.com" class="btn btn-secondary">Email me</a>
    </div>
  </div>

  {/* Expressive 3D scroll piece, kept as the signature visual. */}
  <div class="container-site border-t border-[var(--color-border-subtle)] pt-4">
    <HeroScroll client:load />
  </div>
</section>
