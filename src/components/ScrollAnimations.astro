---
// Client-side scroll-driven animations using GSAP + ScrollTrigger.
// Loaded once at the bottom of every page. Honours prefers-reduced-motion.
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function init() {
    if (reduced) return;

    /*  Hero: large display text fades + slides up on load  */
    const heroDisplays = document.querySelectorAll<HTMLElement>(
      '[aria-labelledby="hero-heading"] .display-script, [aria-labelledby="hero-heading"] .display-mark, [aria-labelledby="hero-heading"] .ds-pill'
    );
    if (heroDisplays.length) {
      gsap.set(heroDisplays, { y: 40, opacity: 0 });
      gsap.to(heroDisplays, {
        y: 0,
        opacity: 1,
        duration: 1.4,
        ease: 'expo.out',
        stagger: 0.08,
      });
    }

    /*  Every section heading: character cipher reveal on enter
       Splits the heading into spans, scrambles characters into the
       cyber alphabet, then resolves to original chars as you scroll. */
    const cipherChars = '01⌬◇◆⌁⊹∴∵≡≣⏣▣▢█▒░';
    const headings = document.querySelectorAll<HTMLElement>(
      'h2.display-script, [aria-labelledby] h2.display-script'
    );
    headings.forEach((h) => {
      // Walk only the text nodes, leave whitespace and child elements
      // (such as <br>, the amber period <span>, etc.) intact. This keeps
      // word boundaries readable when the cipher is animating.
      const wrap = (root: Node) => {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        const targets: Text[] = [];
        let n: Node | null;
        while ((n = walker.nextNode())) targets.push(n as Text);
        targets.forEach((textNode) => {
          const text = textNode.textContent ?? '';
          const frag = document.createDocumentFragment();
          for (const ch of Array.from(text)) {
            if (/\s/.test(ch)) {
              frag.appendChild(document.createTextNode(ch));
              continue;
            }
            const span = document.createElement('span');
            span.className = 'cipher-char';
            span.dataset.orig = ch;
            span.textContent = ch;
            frag.appendChild(span);
          }
          textNode.replaceWith(frag);
        });
      };
      wrap(h);
      const spans = h.querySelectorAll<HTMLElement>('.cipher-char');

      ScrollTrigger.create({
        trigger: h,
        start: 'top 80%',
        once: true,
        onEnter: () => {
          spans.forEach((s, i) => {
            const orig = s.dataset.orig ?? '';
            if (/\s/.test(orig)) return;
            const ticks = 6 + (i % 4);
            let n = 0;
            const tick = () => {
              n++;
              if (n < ticks) {
                s.textContent =
                  cipherChars[Math.floor(Math.random() * cipherChars.length)];
                setTimeout(tick, 28);
              } else {
                s.textContent = orig;
              }
            };
            setTimeout(tick, i * 18);
          });
        },
      });
    });

    /*  Cards & list items: stagger fade-up on scroll  */
    const fadeGroups = [
      '#services article',
      '#stats dl > div',
      '#experience li',
      '#projects li',
      '#certifications li',
      '#awards li',
      '#blog li',
    ];
    fadeGroups.forEach((sel) => {
      const items = gsap.utils.toArray<HTMLElement>(sel);
      if (!items.length) return;
      gsap.set(items, { y: 32, opacity: 0 });
      ScrollTrigger.batch(items, {
        start: 'top 88%',
        onEnter: (batch) =>
          gsap.to(batch, {
            y: 0,
            opacity: 1,
            duration: 0.9,
            ease: 'expo.out',
            stagger: 0.08,
          }),
      });
    });

    /*  Contact: amber CTA gentle float on hover (handled by CSS)  */

    /*  Refresh once, then on resize  */
    ScrollTrigger.refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style is:global>
  .cipher-char {
    display: inline-block;
    font-variant-ligatures: none;
  }
</style>
