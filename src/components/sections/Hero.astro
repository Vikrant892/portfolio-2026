---
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';

const proof = [
  { label: 'AWS Certified Data Engineer', href: '#achievements' },
  { label: 'OCI Data Science Professional', href: '#achievements' },
  { label: 'NASA Space Apps Global Finalist', href: '#achievements' },
  { label: '7 systems live in production', href: '#work' },
];
---

<section
  class="relative isolate overflow-hidden border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)]"
  aria-labelledby="hero-heading"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_78%_18%,_var(--color-amber-glow)_0%,_transparent_55%)]"
  >
  </div>

  <div class="container-site grid grid-cols-1 gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-8 lg:py-24">
    {/* LEFT: the pitch */}
    <div class="lg:col-span-7">
      <h1 id="hero-heading">
        <span data-hero-seq class="t-eyebrow block">
          Vikrant Sharma · Adelaide, Australia
        </span>
        <span
          data-hero-seq
          class="t-display mt-6 block text-[clamp(2.75rem,6.5vw,5rem)] text-[var(--color-ink)]"
        >
          Machine learning,<br />
          built for threat detection<span class="text-[var(--color-accent)]">.</span>
        </span>
      </h1>

      <p
        data-hero-seq
        class="mt-8 max-w-xl text-lg leading-relaxed text-[var(--color-ink-muted)]"
      >
        I build intrusion detection, threat triage and fraud models that run in
        production, not in notebooks. Seven systems live with public demos and
        open source code. Master of IT candidate at UniSC Adelaide with industry
        experience across data engineering and security operations.
      </p>

      <div data-hero-seq class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#work" class="btn btn-primary">View selected work</a>
        <a href="/resume" class="btn btn-secondary">
          Resume
          <span aria-hidden="true" class="text-[var(--color-accent)]">→</span>
        </a>
        <a
          href="mailto:vikrantsharma892@gmail.com"
          class="mono py-2 text-sm text-[var(--color-ink-muted)] underline-offset-4 transition-colors hover:text-[var(--color-accent)] hover:underline"
        >
          vikrantsharma892@gmail.com
        </a>
      </div>

      <ul data-hero-seq class="mt-10 flex flex-wrap gap-2" aria-label="Credentials">
        {
          proof.map((p) => (
            <li>
              <a href={p.href} class="chip transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-ink)]">
                <span
                  aria-hidden="true"
                  class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-amber)]"
                />
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* RIGHT: portrait + availability */}
    <div class="lg:col-span-5">
      <figure data-hero-seq class="relative mx-auto w-full max-w-sm lg:ml-auto">
        <div class="overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
          <Image
            src={portrait}
            alt="Vikrant Sharma"
            widths={[384, 560, 768]}
            sizes="(max-width: 1024px) 90vw, 384px"
            class="h-auto w-full"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="mono mt-3 flex items-center justify-between text-xs text-[var(--color-ink-dim)]">
          <span>Adelaide, ACST</span>
          <span>UniSC · Class of Aug 2027</span>
        </figcaption>
      </figure>

      <div
        data-hero-seq
        class="mx-auto mt-8 w-full max-w-sm rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5 lg:ml-auto"
      >
        <p class="t-eyebrow flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-amber)] opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-amber)]"></span>
          </span>
          Available now
        </p>
        <ul class="mt-3 space-y-1.5 text-sm text-[var(--color-ink-muted)]">
          <li>Internships, 3 to 6 months</li>
          <li>Part-time and casual engineering work</li>
          <li>Full-time over the Nov to Feb break</li>
        </ul>
      </div>
    </div>
  </div>
</section>
