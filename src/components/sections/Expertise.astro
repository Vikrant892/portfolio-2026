---
const domains = [
  {
    n: '01',
    title: 'Threat Detection ML',
    desc: 'Anomaly detection, imbalanced classification and ensemble models for security data, with every alert mapped to MITRE ATT&CK. Most analysts cannot build a model and most ML engineers have never read ATT&CK. I work in the overlap.',
    evidence: 'Evidence: the IDS capstone and fraud model above.',
    tools: ['Python', 'PyTorch', 'scikit-learn', 'XGBoost', 'SMOTE'],
  },
  {
    n: '02',
    title: 'Data Engineering',
    desc: 'Dimensional modelling, ETL pipelines and warehouse work on AWS Redshift and Snowflake. Production experience turning high-volume transactional data into analyst-ready tables.',
    evidence: 'Evidence: Data Engineer at Nagarro, AWS Certified Data Engineer.',
    tools: ['SQL', 'Snowflake', 'Redshift', 'Airflow', 'Pandas'],
  },
  {
    n: '03',
    title: 'Security Operations',
    desc: 'SIEM monitoring, alert triage, OWASP Top 10 testing and compliance audits against ISO 27001 and NIST CSF. The operational grounding that tells me what a detection model actually needs to catch.',
    evidence: 'Evidence: seven months as a security analyst at AT SecurDI.',
    tools: ['SIEM', 'Wireshark', 'Suricata', 'OWASP', 'NIST CSF'],
  },
  {
    n: '04',
    title: 'Production Delivery',
    desc: 'APIs, dashboards and deployment pipelines that put models in front of users. Everything I build ships behind a URL with CI, containers and monitoring.',
    evidence: 'Evidence: seven public deployments, all with source.',
    tools: ['FastAPI', 'Flask', 'React', 'Docker', 'GitHub Actions'],
  },
];

const toolkit = [
  { label: 'Languages', items: 'Python · SQL · TypeScript · JavaScript · Bash · C' },
  { label: 'ML & data', items: 'PyTorch · scikit-learn · XGBoost · Pandas · NumPy · Airflow · Snowflake · Redshift · PostgreSQL' },
  { label: 'Security', items: 'MITRE ATT&CK · OWASP Top 10 · NIST CSF · ISO 27001 · SIEM · Suricata · Wireshark' },
  { label: 'Web & cloud', items: 'FastAPI · Flask · React · Astro · Docker · AWS · OCI · Cloudflare · GitHub Actions · Linux' },
];
---

<section
  id="expertise"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-subtle)] py-20 sm:py-28"
  aria-labelledby="expertise-heading"
>
  <div class="container-site">
    <div class="mb-14 max-w-2xl" data-reveal>
      <p class="t-eyebrow mb-4">Technical expertise</p>
      <h2 id="expertise-heading" class="t-heading text-4xl text-[var(--color-ink)] sm:text-5xl">
        What I do, with receipts<span class="text-[var(--color-accent)]">.</span>
      </h2>
      <p class="mt-5 text-base leading-relaxed text-[var(--color-ink-muted)]">
        Four domains, each anchored to work you can open and run. No skill
        appears here without a project or role behind it.
      </p>
    </div>

    <div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-2"
      data-reveal-group
    >
      {
        domains.map((d) => (
          <article data-reveal-child class="group relative bg-[var(--color-bg-elevated)] p-7 sm:p-9">
            <p class="mono text-xs text-[var(--color-accent)]">{d.n}</p>
            <h3 class="t-title mt-4 text-2xl text-[var(--color-ink)]">{d.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">{d.desc}</p>
            <p class="mono mt-3 text-xs text-[var(--color-ink-dim)]">{d.evidence}</p>
            <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={`${d.title} tools`}>
              {d.tools.map((t) => (
                <li class="chip !py-0.5 !text-[11px]">{t}</li>
              ))}
            </ul>
            <div
              aria-hidden="true"
              class="absolute bottom-0 left-0 h-0.5 w-0 bg-[var(--color-amber)] transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:w-full"
            />
          </article>
        ))
      }
    </div>

    {/* Full toolkit, one scannable block instead of forty hover chips */}
    <dl class="mt-12 grid grid-cols-1 gap-x-12 gap-y-5 sm:grid-cols-2" data-reveal>
      {
        toolkit.map((g) => (
          <div class="border-t border-[var(--color-border)] pt-4">
            <dt class="t-eyebrow">{g.label}</dt>
            <dd class="mono mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">{g.items}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
