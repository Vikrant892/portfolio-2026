---
import BaseLayout from '../layouts/BaseLayout.astro';

const work = [
  {
    role: 'Data Engineer',
    org: 'Nagarro',
    location: 'Adelaide, Australia',
    period: 'Dec 2024 to Feb 2025',
    points: [
      'Designed and optimised dimensional data models on AWS Redshift and Snowflake for enterprise analytics workloads.',
      'Built ETL pipelines that transformed high-volume transactional data into analyst-ready dimensional tables.',
      'Delivered iterative client work via Agile and Scrum, contributing to weekly deliverables for enterprise stakeholders.',
    ],
  },
  {
    role: 'Cybersecurity Junior Analyst',
    org: 'AT SecurDI',
    location: 'Ahmedabad, India',
    period: 'May 2023 to Dec 2023',
    points: [
      'Monitored SIEM platforms and triaged alerts to identify and escalate genuine security incidents.',
      'Authored incident response runbooks adopted by the wider security operations team.',
      'Performed OWASP Top 10 web application security testing for client engagements.',
      'Conducted ISO 27001 and NIST CSF compliance audits across multiple client environments.',
    ],
  },
];

const projects = [
  {
    name: 'Hybrid ML Intrusion Detection System',
    desc: 'Real-time hybrid NIDS and HIDS: Isolation Forest, Random Forest and Autoencoder ensemble on CICIDS2017 with MITRE ATT&CK alert mapping. Master of IT capstone, live on Hugging Face Spaces.',
  },
  {
    name: 'ThreatLens',
    desc: 'FastAPI threat intelligence service correlating NVD CVE data with exploit availability and ATT&CK techniques into a composite triage score.',
  },
  {
    name: 'Credit Card Fraud Detection',
    desc: 'Imbalanced classification pipeline (0.17 per cent positives, 284k transactions): SMOTE, XGBoost comparison, precision-recall threshold tuning.',
  },
  {
    name: 'Cosmic Keys',
    desc: 'NASA Space Apps 2023 Global Finalist. Planetary data sonification engine built with Team Eklavya.',
  },
];

const skills = [
  { label: 'Machine learning', items: 'Python, PyTorch, scikit-learn, XGBoost, SMOTE, Pandas, NumPy, anomaly detection' },
  { label: 'Cybersecurity', items: 'MITRE ATT&CK, OWASP Top 10, NIST CSF, ISO 27001, SIEM, Suricata, Wireshark, incident response' },
  { label: 'Data engineering', items: 'SQL, AWS Redshift, Snowflake, PostgreSQL, Apache Airflow, ETL, dimensional modelling' },
  { label: 'Web, cloud and DevOps', items: 'FastAPI, Flask, React, Astro, TypeScript, Docker, AWS, OCI, Cloudflare, GitHub Actions, Linux' },
];

const certs = [
  'AWS Certified Data Engineer Associate (DEA-C01), May 2026',
  'Oracle Cloud Infrastructure 2025 Certified Data Science Professional, Aug 2025',
  'NASA Space Apps Galactic Problem Solver, Oct 2023',
];
---

<BaseLayout
  title="Resume"
  description="Resume of Vikrant Sharma, machine learning engineer specialising in cybersecurity. Adelaide, Australia."
  bare
>
  <div class="container-site max-w-3xl py-10 sm:py-14 print:max-w-none print:py-0">
    {/* Screen-only toolbar */}
    <nav class="mb-10 flex flex-wrap items-center justify-between gap-3 print:hidden" aria-label="Resume actions">
      <a
        href="/"
        class="mono text-sm text-[var(--color-ink-muted)] underline-offset-4 hover:text-[var(--color-ink)] hover:underline"
      >
        ← vikrant69g.com
      </a>
      <div class="flex gap-2.5">
        <a href="/resume/Vikrant-Sharma-Resume.pdf" class="btn btn-primary !min-h-0 !px-4 !py-2 !text-xs" download>
          Download PDF
        </a>
        <button id="print-btn" type="button" class="btn btn-secondary !min-h-0 !px-4 !py-2 !text-xs">
          Print
        </button>
      </div>
    </nav>

    <article>
      <header class="border-b-2 border-[var(--color-ink)] pb-6">
        <h1 class="t-display text-4xl text-[var(--color-ink)] sm:text-5xl">Vikrant Sharma</h1>
        <p class="mt-2 text-lg text-[var(--color-ink-muted)]">
          Machine Learning Engineer specialising in Cybersecurity
        </p>
        <p class="mono mt-3 text-sm text-[var(--color-ink-dim)]">
          Adelaide, South Australia ·
          <a href="mailto:vikrantsharma892@gmail.com" class="underline-offset-4 hover:underline">vikrantsharma892@gmail.com</a> ·
          <a href="https://vikrant69g.com" class="underline-offset-4 hover:underline">vikrant69g.com</a> ·
          <a href="https://github.com/Vikrant892" class="underline-offset-4 hover:underline">github.com/Vikrant892</a> ·
          <a href="https://www.linkedin.com/in/vik892/" class="underline-offset-4 hover:underline">linkedin.com/in/vik892</a>
        </p>
      </header>

      <section class="mt-8" aria-label="Summary">
        <p class="text-[15px] leading-relaxed text-[var(--color-ink-muted)]">
          Machine learning engineer who builds threat detection systems that
          ship. Seven production ML and security systems with live public demos
          and open source code. Industry experience across data engineering at
          Nagarro and security operations at AT SecurDI. NASA Space Apps Global
          Finalist 2023. Master of IT candidate at UniSC Adelaide, graduating
          August 2027. Open to internships and part-time work now, full-time
          over the November to February break.
        </p>
      </section>

      <section class="mt-8" aria-labelledby="r-exp">
        <h2 id="r-exp" class="t-eyebrow border-b border-[var(--color-border)] pb-2">Experience</h2>
        {
          work.map((w) => (
            <div class="mt-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6">
                <h3 class="t-title text-lg text-[var(--color-ink)]">
                  {w.role} · {w.org}
                </h3>
                <p class="mono text-xs text-[var(--color-ink-dim)]">
                  {w.period} · {w.location}
                </p>
              </div>
              <ul class="mt-2 space-y-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                {w.points.map((p) => (
                  <li class="flex gap-2.5">
                    <span aria-hidden="true" class="mt-[0.6em] inline-block h-1 w-2.5 shrink-0 bg-[var(--color-amber)]" />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="mt-8" aria-labelledby="r-proj">
        <h2 id="r-proj" class="t-eyebrow border-b border-[var(--color-border)] pb-2">
          Selected projects, all live at vikrant69g.com
        </h2>
        <ul class="mt-4 space-y-3">
          {
            projects.map((p) => (
              <li class="text-sm leading-relaxed">
                <span class="font-semibold text-[var(--color-ink)]">{p.name}.</span>
                <span class="text-[var(--color-ink-muted)]"> {p.desc}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-8" aria-labelledby="r-skills">
        <h2 id="r-skills" class="t-eyebrow border-b border-[var(--color-border)] pb-2">Skills</h2>
        <dl class="mt-4 space-y-2 text-sm leading-relaxed">
          {
            skills.map((s) => (
              <div class="flex flex-col sm:flex-row sm:gap-3">
                <dt class="w-48 shrink-0 font-semibold text-[var(--color-ink)]">{s.label}</dt>
                <dd class="text-[var(--color-ink-muted)]">{s.items}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="mt-8" aria-labelledby="r-certs">
        <h2 id="r-certs" class="t-eyebrow border-b border-[var(--color-border)] pb-2">
          Certifications and awards
        </h2>
        <ul class="mt-4 space-y-1.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          {
            certs.map((c) => (
              <li class="flex gap-2.5">
                <span aria-hidden="true" class="mt-[0.6em] inline-block h-1 w-2.5 shrink-0 bg-[var(--color-amber)]" />
                <span>{c}</span>
              </li>
            ))
          }
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="mt-[0.6em] inline-block h-1 w-2.5 shrink-0 bg-[var(--color-amber)]"></span>
            <span>NASA Space Apps Challenge Global Finalist, Team Eklavya, 2023</span>
          </li>
        </ul>
      </section>

      <section class="mt-8" aria-labelledby="r-edu">
        <h2 id="r-edu" class="t-eyebrow border-b border-[var(--color-border)] pb-2">Education</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed">
          <li>
            <span class="font-semibold text-[var(--color-ink)]">Master of Information Technology.</span>
            <span class="text-[var(--color-ink-muted)]">
              University of the Sunshine Coast, Adelaide. 2025 to Aug 2027.
            </span>
          </li>
          <li>
            <span class="font-semibold text-[var(--color-ink)]">Bachelor of Computer Applications.</span>
            <span class="text-[var(--color-ink-muted)]">CHARUSAT, CMPICA. 2021 to 2024.</span>
          </li>
        </ul>
      </section>
    </article>
  </div>

  <script>
    document.getElementById('print-btn')?.addEventListener('click', () => window.print());
  </script>

  <style is:global>
    /* The resume reads and prints as a light document regardless of the
       site theme. Token override is page-scoped: each Astro page is its
       own HTML document. */
    html {
      color-scheme: light;
      --color-bg: #ffffff;
      --color-bg-elevated: #fafafa;
      --color-bg-subtle: #f4f4f5;
      --color-ink: #18181b;
      --color-ink-muted: #3f3f46;
      --color-ink-dim: #65656e;
      --color-border: #e4e4e7;
      --color-border-subtle: #ededf0;
      --color-border-strong: #c9c9d1;
      --color-accent: #0e7490;
      --color-amber: #0e7490;
      background: #ffffff;
    }

    @media print {
      body {
        font-size: 12px;
      }
      .btn {
        display: none;
      }
    }
  </style>
</BaseLayout>
