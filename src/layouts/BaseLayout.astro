---
import { getImage } from 'astro:assets';
import '../styles/globals.css';
import Header from '../components/Header.astro';
import Motion from '../components/Motion.astro';
import ImageGuard from '../components/ImageGuard.astro';
import portrait from '../assets/portrait.jpg';
import { identity } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Hide the sticky site header (used by the print-friendly resume page). */
  bare?: boolean;
}

const {
  title,
  description = `${identity.name}. ${identity.jobTitle} with a security background. AWS Certified Data Engineer, OCI Data Science Professional, NASA Space Apps Global Finalist. ${identity.location}.`,
  noindex = false,
  bare = false,
} = Astro.props;

const fullTitle =
  title.toLowerCase() === 'home'
    ? 'Vikrant Sharma | Data Engineering, ML & Security'
    : `${title} | Vikrant Sharma`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const ogImage = await getImage({ src: portrait, width: 1200, format: 'jpeg' });
const ogImageURL = new URL(ogImage.src, Astro.site).toString();

// Branded 1200x630 social share card (static, in /public). Used for
// og:image and twitter:image so shared links render a deliberate card,
// not a raw headshot. The plain headshot still feeds the Person schema.
const ogCardURL = new URL('/og.jpg', Astro.site).toString();

const SITE = 'https://vikrant69g.com';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

// One linked @graph: the WebSite, the Person, and (on the home page) a
// ProfilePage whose mainEntity is the Person. Linking by @id is what
// tells Google this whole site IS the entity "Vikrant Sharma", which is
// what a name search resolves against.
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'Vikrant Sharma',
      alternateName: ['Vikrant Sharma Portfolio', 'vikrant69g', 'Vikrant'],
      inLanguage: 'en-AU',
      publisher: { '@id': `${SITE}/#person` },
      about: { '@id': `${SITE}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE}/#person`,
      name: 'Vikrant Sharma',
      givenName: 'Vikrant',
      familyName: 'Sharma',
      url: SITE,
      mainEntityOfPage: SITE,
      image: ogImageURL,
      email: 'mailto:vikrantsharma892@gmail.com',
      jobTitle: identity.jobTitle,
      worksFor: {
        '@type': 'Organization',
        name: 'Voxon',
        description: 'Industry placement, AI capabilities in VoxelOS',
      },
      description: `${identity.jobTitle} with a security background. AWS Certified Data Engineer, OCI Data Science Professional, NASA Space Apps Global Finalist. Based in ${identity.location}.`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Adelaide',
        addressRegion: 'South Australia',
        addressCountry: 'AU',
      },
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'University of the Sunshine Coast (Adelaide Campus)',
        },
        {
          '@type': 'CollegeOrUniversity',
          name: 'Charotar University of Science and Technology',
        },
      ],
      knowsAbout: [
        'Data Engineering',
        'Machine Learning',
        'Cybersecurity',
        'Intrusion Detection',
        'Threat Intelligence',
      ],
      knowsLanguage: ['English', 'Hindi'],
      sameAs: [
        'https://github.com/Vikrant892',
        'https://www.linkedin.com/in/vik892/',
        'https://x.com/Vik69G',
      ],
    },
    ...(isHome
      ? [
          {
            '@type': 'ProfilePage',
            '@id': `${SITE}/#webpage`,
            url: SITE,
            name: 'Vikrant Sharma | Data Engineering, ML & Security',
            isPartOf: { '@id': `${SITE}/#website` },
            about: { '@id': `${SITE}/#person` },
            mainEntity: { '@id': `${SITE}/#person` },
            inLanguage: 'en-AU',
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vikrant Sharma" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vikrant Sharma" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogCardURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vikrant Sharma — machine learning, built to hunt threats" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogCardURL} />
    <meta name="twitter:image:alt" content="Vikrant Sharma — machine learning, built to hunt threats" />

    <meta name="theme-color" content="#faf9f5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    {/* Gate for reveal styles and saved theme: must run before first
        paint so content never flashes hidden or in the wrong theme. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', '#0b0b0f');
        }
      } catch {
        /* private browsing: default to light */
      }
    </script>
  </head>
  <body id="top" class="min-h-svh bg-[var(--color-bg)] text-[var(--color-ink)]">
    <a href="#main" class="skip-link">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {/* Motion powers [data-reveal] animations on the classic section pages;
        bare pages (immersive home, resume, recruiter) don't use it, so skip
        the 63 KB script there. */}
    {!bare && <Motion />}
    <ImageGuard />
  </body>
</html>
